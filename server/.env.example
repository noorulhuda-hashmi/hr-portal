PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hr_portal
# Kam az kam 16 characters ka lamba random text. Kisi ko na batayein
JWT_SECRET=change_this_to_a_long_random_text
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Is waqt ke baad check-in "late" shumar hota hai (24 ghante ka format)
LATE_AFTER=09:15

# Sirf "npm run seed" se pehla admin banane ke liye (baad mein hata dein)
# ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password

# Online deploy par: NODE_ENV=production
# NODE_ENV=production
